# Dependencies / build
node_modules/
dist/
dist-emulator/
.vite/
.vitest/

# Local env & secrets (none should ever exist, but belt-and-braces)
.env
.env.*
*.local
# ...except the emulator switch, which is a mode flag rather than a secret and
# has to be committed or `npm run dev:emulator` does nothing on a fresh clone.
!.env.emulator

# Firebase local artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
emulator-data/

# Editor/OS noise
.DS_Store
Thumbs.db
*.swp

# UI inspiration images — third-party design work, local reference only
design-refs/

# demo video build artifacts (regenerate with docs/slides/build-video.sh)
docs/slides/repocircle-demo.mp4
docs/slides/.parts/

# Generated test reports (TESTING.md §5) — regenerate with `npm run report`.
# Local-first for now; a cloud store later syncs this same tree.
reports/
