rules_version = '2';

// RepoCircle security rules v1 — the entire server-side authorization layer.
// Design + threat model: docs/SECURITY.md. Limits mirror src/util/limits.ts.
// Principles: default deny; membership gates every group path; role checks on
// privileged writes; key allowlists + shape validation on every create/update;
// state machines enforced here, not in the client.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(me());
    }
    function isMember(gid) { return signedIn() && exists(memberPath(gid)); }
    function memberRole(gid) { return get(memberPath(gid)).data.role; }
    // guest + alumnus are read-only roles
    function canWrite(gid) {
      return isMember(gid) && memberRole(gid) in ['admin', 'member', 'mentor'];
    }
    function isAdmin(gid) { return isMember(gid) && memberRole(gid) == 'admin'; }
    function str(x, min, max) { return x is string && x.size() >= min && x.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || str(d[k], 0, max); }
    function optHttpsUrl(d, k) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].matches('^https://.{1,300}$'));
    }
    // helpWith joins against repo.needs, so its vocabulary is closed; learning is
    // free text but bounded. Rules can't loop, so with size capped at 6 the item
    // checks are spelled out per index (an index past the end passes vacuously).
    function learningItem(l, i) { return l.size() <= i || (l[i] is string && l[i].size() <= 24); }
    // M17: what a member wants to build. Closed vocabulary for the same reason
    // helpWith is closed — the join screen offers chips, never a text field, so
    // the values stay joinable rather than becoming prose.
    function validDomainTags(d) {
      return !('domainTags' in d) || (d.domainTags is list && d.domainTags.size() <= 4
        && d.domainTags.hasOnly(['web', 'mobile', 'ML', 'tooling', 'game', 'hardware',
                                 'data', 'other']));
    }
    function validSkills(d) {
      return d.helpWith is list && d.helpWith.size() <= 5
        && d.helpWith.hasOnly(['feedback', 'frontend', 'backend', 'ml', 'design'])
        && d.learning is list && d.learning.size() <= 6
        && learningItem(d.learning, 0) && learningItem(d.learning, 1)
        && learningItem(d.learning, 2) && learningItem(d.learning, 3)
        && learningItem(d.learning, 4) && learningItem(d.learning, 5)
        && validDomainTags(d);
    }
    function inviteValid(gid, token) {
      let inv = get(/databases/$(database)/documents/groups/$(gid)/invites/$(token)).data;
      return inv.revoked == false && inv.expiresAt > request.time;
    }
    function repoData(gid, repoId) {
      return get(/databases/$(database)/documents/groups/$(gid)/repos/$(repoId)).data;
    }
    function canManageRepo(gid, repoId) {
      return isAdmin(gid)
        || repoData(gid, repoId).registeredBy == me()
        || repoData(gid, repoId).ownerUid == me();
    }
    // M16 summary doc (ADR-021): a capped display mirror. It authorizes
    // nothing, so the rules police shape and size, not truth.
    function sumInt(d, k) { return !(k in d) || d[k] is int; }
    function sumList(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }
    function validSummary(d) {
      return d.keys().hasOnly(['memberCount', 'repoCount', 'openAskCount',
                               'links', 'pinnedRepoId', 'v'])
        && sumInt(d, 'memberCount') && sumInt(d, 'repoCount') && sumInt(d, 'openAskCount')
        && sumList(d, 'links', 6)
        && (!('pinnedRepoId' in d) || d.pinnedRepoId == null || str(d.pinnedRepoId, 1, 20));
    }
    // links + pinnedRepoId are the admin surface (M17); everything else is
    // maintained by whichever member's client performed the underlying write.
    function summaryTouchesAdminKeys() {
      return resource == null
        ? (('links' in request.resource.data && request.resource.data.links.size() > 0)
           || ('pinnedRepoId' in request.resource.data
               && request.resource.data.pinnedRepoId != null))
        : request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['links', 'pinnedRepoId']);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(
             ['githubId', 'login', 'name', 'avatarUrl', 'scopesGranted', 'groupIds',
              'checklist', 'circlePrefs', 'createdAt', 'lastSeenAt', 'v'])
        && (!('circlePrefs' in request.resource.data)
            || request.resource.data.circlePrefs is map)
        && str(request.resource.data.login, 1, 60)
        // githubId immutable once set
        && (resource == null || !('githubId' in resource.data)
            || request.resource.data.githubId == resource.data.githubId);
    }

    // ---------- users/{uid}/watches — what I saved, across circles ----------
    // M18 widened this from repos to anything worth coming back to. The old
    // repoId/fullName keys stay allowed so watches written before then keep
    // working; new documents carry kind/itemId/title.
    match /users/{uid}/watches/{watchId} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(
             ['gid', 'kind', 'itemId', 'title', 'repoId', 'fullName', 'addedAt', 'v'])
        && str(request.resource.data.gid, 1, 60)
        && (!('kind' in request.resource.data)
            || request.resource.data.kind in ['repo', 'ask', 'idea'])
        && (!('itemId' in request.resource.data) || str(request.resource.data.itemId, 1, 60))
        && (!('title' in request.resource.data) || str(request.resource.data.title, 1, 200))
        && (!('repoId' in request.resource.data) || str(request.resource.data.repoId, 1, 20))
        && (!('fullName' in request.resource.data) || str(request.resource.data.fullName, 3, 140));
    }

    // ---------- collection-group reads (recent discussion, away-inbox) ----------
    // A collection-group query only passes when it pins gid with an equality
    // filter: the engine then binds resource.data.gid to that constant and can
    // prove isMember(). Docs written before the gid field simply never match.
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn() && resource.data.gid is string && isMember(resource.data.gid);
    }
    match /{path=**}/interests/{interestUid} {
      allow read: if signedIn() && resource.data.gid is string && isMember(resource.data.gid);
    }

    // ---------- groups ----------
    match /groups/{gid} {
      allow get: if isMember(gid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'description', 'visibility', 'createdBy', 'memberCount', 'settings',
              'createdAt', 'v'])
        && request.resource.data.createdBy == me()
        && str(request.resource.data.name, 3, 50)
        && optStr(request.resource.data, 'description', 280)
        && request.resource.data.visibility == 'private';
      allow update: if isAdmin(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'visibility', 'settings', 'memberCount'])
        && str(request.resource.data.name, 3, 50)
        && optStr(request.resource.data, 'description', 280)
        && request.resource.data.visibility in ['private', 'public_page'];
      // Deletion sweep order keeps the admin's membership doc alive until after
      // this delete, so isAdmin() still resolves here.
      allow delete: if isAdmin(gid);

      // ---------- members ----------
      match /members/{uid} {
        allow read: if isMember(gid);
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(
               ['role', 'login', 'name', 'avatarUrl', 'availability', 'helpWith', 'learning',
                'domainTags', 'checklist', 'repoSync', 'joinedAt', 'joinedVia', 'v'])
          && str(request.resource.data.login, 1, 60)
          && validSkills(request.resource.data)
          && (
            (request.resource.data.joinedVia == 'founder'
              && getAfter(/databases/$(database)/documents/groups/$(gid)).data.createdBy == me()
              && request.resource.data.role == 'admin')
            ||
            (request.resource.data.joinedVia != 'founder'
              && inviteValid(gid, request.resource.data.joinedVia)
              && request.resource.data.role ==
                   get(/databases/$(database)/documents/groups/$(gid)/invites/$(request.resource.data.joinedVia)).data.role)
          );
        allow update: if
          (me() == uid && isMember(gid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['availability', 'helpWith', 'learning', 'domainTags', 'checklist',
                           'repoSync', 'login', 'name', 'avatarUrl'])
            && validSkills(request.resource.data))
          ||
          (isAdmin(gid) && me() != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['admin', 'member', 'guest', 'mentor', 'alumnus']);
        allow delete: if me() == uid || isAdmin(gid);
      }

      // ---------- invites (token = doc id; get by token; list = admins only) ----------
      match /invites/{token} {
        allow get: if signedIn();
        allow list: if isAdmin(gid);   // invite management screen; members still cannot enumerate
        allow create: if isAdmin(gid)
          && request.resource.data.keys().hasOnly(
               ['role', 'expiresAt', 'revoked', 'createdBy', 'createdByLogin', 'groupName',
                'groupDescription', 'memberCount', 'repoCount', 'createdAt', 'label', 'v'])
          && request.resource.data.role in ['member', 'guest']   // never admin-by-link
          && request.resource.data.revoked == false
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
          && request.resource.data.createdBy == me()
          && optStr(request.resource.data, 'label', 40);
        allow update: if isAdmin(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'label'])
          && optStr(request.resource.data, 'label', 40);
        allow delete: if isAdmin(gid);
      }

      // ---------- repos ----------
      match /repos/{repoId} {
        allow read: if isMember(gid);
        allow create: if canWrite(gid)
          && repoId.matches('[0-9]{1,16}')
          && request.resource.data.keys().hasOnly(
               ['fullName', 'htmlUrl', 'description', 'language', 'topics', 'githubOwnerLogin',
                'ownerUid', 'registeredBy', 'status', 'demoUrl', 'archived', 'lastEventAt',
                'poll', 'stats7d', 'daily', 'pitch', 'needs', 'needsSince', 'domainTags',
                'seekingOwner', 'interestCount', 'commentCount', 'createdAt', 'v'])
          && request.resource.data.registeredBy == me()
          && str(request.resource.data.fullName, 3, 140)
          && request.resource.data.status in ['idea', 'building', 'paused', 'done']
          && request.resource.data.archived == false
          && optHttpsUrl(request.resource.data, 'demoUrl')
          && optHttpsUrl(request.resource.data, 'htmlUrl')
          && optStr(request.resource.data, 'description', 500);
        // Any writer may refresh metadata/poll state (shared polling engine, M3);
        // product fields (status, demoUrl, archived) are owner/registrant/admin only.
        allow update: if canWrite(gid)
          && request.resource.data.keys().hasOnly(
               ['fullName', 'htmlUrl', 'description', 'language', 'topics', 'githubOwnerLogin',
                'ownerUid', 'registeredBy', 'status', 'demoUrl', 'archived', 'lastEventAt',
                'poll', 'stats7d', 'daily', 'pitch', 'needs', 'needsSince', 'domainTags',
                'seekingOwner',
                'adoptedByUid', 'adoptedByLogin', 'adoptedFromLogin', 'adoptedAt', 'ownerLeft',
                'ideaId', 'ideaByLogin',
                'interestCount', 'commentCount', 'createdAt', 'v'])
          && request.resource.data.registeredBy == resource.data.registeredBy
          && request.resource.data.status in ['idea', 'building', 'paused', 'done']
          && optHttpsUrl(request.resource.data, 'demoUrl')
          && optStr(request.resource.data, 'description', 500)
          && optStr(request.resource.data, 'pitch', 200)
          && (!('domainTags' in request.resource.data)
              || (request.resource.data.domainTags is list
                  && request.resource.data.domainTags.size() <= 4))
          && (
            // Anyone may bump interestCount (mirror of the interests subcollection);
            // everything descriptive belongs to the owner, registrant or an admin.
            !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['status', 'demoUrl', 'archived', 'pitch', 'needs', 'needsSince',
                        'domainTags',
                        'seekingOwner', 'ownerUid', 'adoptedByUid', 'adoptedByLogin',
                        'adoptedFromLogin', 'adoptedAt', 'ownerLeft', 'ideaId', 'ideaByLogin'])
            || isAdmin(gid)
            || resource.data.ownerUid == me()
            || resource.data.registeredBy == me()
          )
          && optStr(request.resource.data, 'adoptedByLogin', 60)
          && optStr(request.resource.data, 'adoptedFromLogin', 60)
          && (
            // ownership never moves silently: a change must be a recorded
            // handover to a real member of this circle
            request.resource.data.ownerUid == resource.data.ownerUid
            || (request.resource.data.ownerUid is string
                && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.resource.data.ownerUid))
                && request.resource.data.adoptedByUid == request.resource.data.ownerUid)
          );
        allow delete: if isMember(gid) && canManageRepo(gid, repoId);

        // events: append-only (TTL reaps); deletes only via deregistration sweep
        match /events/{eventId} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid)
            && request.resource.data.keys().hasOnly(
                 ['type', 'actorLogin', 'actorAvatarUrl', 'summary', 'url', 'occurredAt',
                  'source', 'expireAt', 'v'])
            && str(request.resource.data.summary, 1, 200)
            && request.resource.data.occurredAt is timestamp
            && request.resource.data.expireAt is timestamp
            && request.resource.data.source == 'poll'
            && optHttpsUrl(request.resource.data, 'url');
          allow update: if false;
          allow delete: if isMember(gid) && canManageRepo(gid, repoId);
        }


        // Discussion. Author owns their words; the repo owner and admins moderate.
        match /comments/{commentId} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid)
            && request.resource.data.keys().hasOnly(
                 ['authorUid', 'authorLogin', 'authorAvatarUrl', 'body', 'parentId',
                  'mentions', 'repoRefs', 'pinned', 'gid', 'replyToUid', 'createdAt',
                  'editedAt', 'v'])
            && request.resource.data.authorUid == me()
            && str(request.resource.data.body, 1, 1000)
            && request.resource.data.pinned == false
            && (!('gid' in request.resource.data) || request.resource.data.gid == gid)
            && optStr(request.resource.data, 'replyToUid', 128)
            && (!('mentions' in request.resource.data)
                || (request.resource.data.mentions is list
                    && request.resource.data.mentions.size() <= 10));
          allow update: if isMember(gid) && (
            // author edits their own text
            (resource.data.authorUid == me() && canWrite(gid)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['body', 'mentions', 'repoRefs', 'editedAt'])
              && str(request.resource.data.body, 1, 1000))
            // owner/admin pins or unpins
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
                && (isAdmin(gid) || canManageRepo(gid, repoId)))
          );
          allow delete: if resource.data.authorUid == me()
            || isAdmin(gid)
            || canManageRepo(gid, repoId);
        }

        // "I'm interested" — one doc per member, and only ever your own.
        match /interests/{uid} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid) && me() == uid
            && request.resource.data.keys().hasOnly(
                 ['login', 'avatarUrl', 'note', 'gid', 'repoOwnerUid', 'createdAt', 'v'])
            && str(request.resource.data.login, 1, 60)
            && optStr(request.resource.data, 'note', 140)
            && (!('gid' in request.resource.data) || request.resource.data.gid == gid)
            // repoOwnerUid routes the owner's away-inbox — it must be the truth
            && (!('repoOwnerUid' in request.resource.data)
                || request.resource.data.repoOwnerUid == repoData(gid, repoId).ownerUid);
          allow update: if false;
          allow delete: if me() == uid || isAdmin(gid) || canManageRepo(gid, repoId);
        }

        match /activityDaily/{day} {
          allow read: if isMember(gid);
          allow create, update: if canWrite(gid)
            && day.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(
                 ['commits', 'prsOpened', 'prsMerged', 'issuesOpened', 'releases', 'v'])
            && request.resource.data.commits is int && request.resource.data.commits >= 0
            && request.resource.data.prsOpened is int && request.resource.data.prsOpened >= 0
            && request.resource.data.prsMerged is int && request.resource.data.prsMerged >= 0
            && request.resource.data.issuesOpened is int && request.resource.data.issuesOpened >= 0
            && request.resource.data.releases is int && request.resource.data.releases >= 0;
          allow delete: if isMember(gid) && canManageRepo(gid, repoId);
        }
      }

      // ---------- ideas — repos minus the code (M15) ----------
      // Same vocabulary and mechanics as repos (pitch/needs/tags, comments,
      // interests); one lifecycle: open → germinated (linked to a real repo) or
      // parked. Facts never move — germination links both ways and leaves the
      // idea doc as the historical record.
      match /ideas/{ideaId} {
        allow read: if isMember(gid);
        allow create: if canWrite(gid)
          && request.resource.data.keys().hasOnly(
               ['title', 'pitch', 'detail', 'domainTags', 'needs', 'authorUid', 'authorLogin',
                'authorAvatarUrl', 'state', 'interestCount', 'commentCount', 'createdAt', 'v'])
          && request.resource.data.authorUid == me()
          && request.resource.data.state == 'open'
          && str(request.resource.data.title, 4, 80)
          && str(request.resource.data.pitch, 4, 200)
          && optStr(request.resource.data, 'detail', 1000)
          && (!('domainTags' in request.resource.data)
              || (request.resource.data.domainTags is list
                  && request.resource.data.domainTags.size() <= 4))
          && (!('needs' in request.resource.data) || request.resource.data.needs == null
              || request.resource.data.needs in ['feedback', 'frontend', 'backend', 'ml', 'design', 'anything'])
          && request.resource.data.interestCount == 0
          && request.resource.data.commentCount == 0;
        allow update: if canWrite(gid) && (
          // author (or admin): edit the pitch, park/reopen — never fake a germination
          ((resource.data.authorUid == me() || isAdmin(gid))
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'pitch', 'detail', 'domainTags', 'needs', 'state',
                           'interestCount', 'commentCount'])
            && str(request.resource.data.title, 4, 80)
            && str(request.resource.data.pitch, 4, 200)
            && optStr(request.resource.data, 'detail', 1000)
            && request.resource.data.state in ['open', 'parked'])
          ||
          // germination: author, admin, or the owner/registrant of the repo it
          // became — someone ELSE building your idea is the point. The repo must
          // really exist here; the doc stays as the record.
          (resource.data.state in ['open', 'parked']
            && request.resource.data.state == 'germinated'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['state', 'repoId', 'repoFullName', 'germinatedAt',
                           'germinatedByUid', 'germinatedByLogin'])
            && request.resource.data.germinatedByUid == me()
            && str(request.resource.data.repoFullName, 3, 140)
            && exists(/databases/$(database)/documents/groups/$(gid)/repos/$(request.resource.data.repoId))
            && (resource.data.authorUid == me() || isAdmin(gid)
                || repoData(gid, request.resource.data.repoId).ownerUid == me()
                || repoData(gid, request.resource.data.repoId).registeredBy == me()))
          ||
          // mirrors: anyone writing may bump the counters
          (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['interestCount', 'commentCount'])
            && request.resource.data.interestCount is int
            && request.resource.data.commentCount is int)
        );
        allow delete: if resource.data.authorUid == me() || isAdmin(gid);

        // Discussion — identical shape to repo/ask comments so collection-group
        // reads, mentions and the away-inbox cover ideas for free.
        match /comments/{commentId} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid)
            && request.resource.data.keys().hasOnly(
                 ['authorUid', 'authorLogin', 'authorAvatarUrl', 'body', 'parentId',
                  'mentions', 'repoRefs', 'pinned', 'gid', 'replyToUid', 'createdAt',
                  'editedAt', 'v'])
            && request.resource.data.authorUid == me()
            && str(request.resource.data.body, 1, 1000)
            && request.resource.data.pinned == false
            && (!('gid' in request.resource.data) || request.resource.data.gid == gid)
            && optStr(request.resource.data, 'replyToUid', 128)
            && (!('mentions' in request.resource.data)
                || (request.resource.data.mentions is list
                    && request.resource.data.mentions.size() <= 10));
          allow update: if isMember(gid) && (
            (resource.data.authorUid == me() && canWrite(gid)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['body', 'mentions', 'repoRefs', 'editedAt'])
              && str(request.resource.data.body, 1, 1000))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
                && (isAdmin(gid)
                    || get(/databases/$(database)/documents/groups/$(gid)/ideas/$(ideaId)).data.authorUid == me()))
          );
          allow delete: if resource.data.authorUid == me() || isAdmin(gid)
            || get(/databases/$(database)/documents/groups/$(gid)/ideas/$(ideaId)).data.authorUid == me();
        }

        // "I'd build this" — one doc per member; routes the author's away-inbox,
        // so repoOwnerUid must be the idea author (spoof-checked like repos').
        match /interests/{uid} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid) && me() == uid
            && request.resource.data.keys().hasOnly(
                 ['login', 'avatarUrl', 'note', 'gid', 'repoOwnerUid', 'createdAt', 'v'])
            && str(request.resource.data.login, 1, 60)
            && optStr(request.resource.data, 'note', 140)
            && (!('gid' in request.resource.data) || request.resource.data.gid == gid)
            && (!('repoOwnerUid' in request.resource.data)
                || request.resource.data.repoOwnerUid ==
                     get(/databases/$(database)/documents/groups/$(gid)/ideas/$(ideaId)).data.authorUid);
          allow update: if false;
          allow delete: if me() == uid || isAdmin(gid)
            || get(/databases/$(database)/documents/groups/$(gid)/ideas/$(ideaId)).data.authorUid == me();
        }
      }

      // ---------- asks & stuck flags ----------
      match /asks/{askId} {
        allow read: if isMember(gid);
        allow create: if canWrite(gid)
          && request.resource.data.keys().hasAll(['kind', 'title', 'state', 'authorUid', 'createdAt'])
          && request.resource.data.keys().hasOnly(
               ['kind', 'title', 'detail', 'tags', 'repoId', 'pairingUrl', 'authorUid',
                'authorLogin', 'authorAvatarUrl', 'state', 'claimCount', 'claimerUids',
                'commentCount', 'createdAt', 'resolvedAt', 'v'])
          && request.resource.data.authorUid == me()
          && request.resource.data.state == 'open'
          && request.resource.data.kind in ['ask', 'stuck']
          && str(request.resource.data.title, 4, 120)
          && optStr(request.resource.data, 'detail', 500)
          && (!('tags' in request.resource.data)
              || (request.resource.data.tags is list && request.resource.data.tags.size() <= 8))
          && optHttpsUrl(request.resource.data, 'pairingUrl')
          && (!('claimCount' in request.resource.data) || request.resource.data.claimCount == 0);
        allow update: if canWrite(gid) && (
          // author (or admin): edit content, resolve/reopen own ask
          ((resource.data.authorUid == me() || isAdmin(gid))
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'detail', 'tags', 'repoId', 'pairingUrl', 'state',
                           'resolvedAt', 'claimCount', 'claimerUids', 'commentCount',
                           'authorLogin', 'authorAvatarUrl', 'resolvedWithUid',
                           'resolvedWithLogin'])
            && optStr(request.resource.data, 'resolvedWithUid', 128)
            && optStr(request.resource.data, 'resolvedWithLogin', 60)
            && str(request.resource.data.title, 4, 120)
            && optStr(request.resource.data, 'detail', 500)
            && request.resource.data.state in ['open', 'claimed', 'resolved'])
          ||
          // any writer: claim / unclaim transitions only (never to resolved)
          (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['state', 'claimCount', 'claimerUids', 'commentCount'])
            && resource.data.state in ['open', 'claimed']
            && request.resource.data.state in ['open', 'claimed']
            && request.resource.data.claimCount is int
            && request.resource.data.claimCount >= 0
            && (!('claimerUids' in request.resource.data)
                || request.resource.data.claimerUids is list))
        );
        allow delete: if resource.data.authorUid == me() || isAdmin(gid);

        match /comments/{commentId} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid)
            && request.resource.data.keys().hasOnly(
                 ['authorUid', 'authorLogin', 'authorAvatarUrl', 'body', 'parentId',
                  'mentions', 'repoRefs', 'pinned', 'gid', 'replyToUid', 'createdAt',
                  'editedAt', 'v'])
            && request.resource.data.authorUid == me()
            && str(request.resource.data.body, 1, 1000)
            && request.resource.data.pinned == false
            && (!('gid' in request.resource.data) || request.resource.data.gid == gid)
            && optStr(request.resource.data, 'replyToUid', 128);
          allow update: if isMember(gid) && (
            (resource.data.authorUid == me() && canWrite(gid)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['body', 'mentions', 'repoRefs', 'editedAt'])
              && str(request.resource.data.body, 1, 1000))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
                && (isAdmin(gid) || get(/databases/$(database)/documents/groups/$(gid)/asks/$(askId)).data.authorUid == me()))
          );
          allow delete: if resource.data.authorUid == me() || isAdmin(gid)
            || get(/databases/$(database)/documents/groups/$(gid)/asks/$(askId)).data.authorUid == me();
        }

        match /claims/{uid} {
          allow read: if isMember(gid);
          allow create: if canWrite(gid) && me() == uid
            && request.resource.data.keys().hasOnly(['login', 'avatarUrl', 'note', 'claimedAt', 'v'])
            && optStr(request.resource.data, 'note', 140);
          allow update: if false;
          allow delete: if me() == uid || isAdmin(gid);
        }
      }

      // ---------- collaborator requests ----------
      match /collabRequests/{reqId} {
        allow read: if isMember(gid);
        allow create: if canWrite(gid)
          && request.resource.data.keys().hasOnly(
               ['repoId', 'repoFullName', 'requesterUid', 'requesterLogin', 'note',
                'repoOwnerUid', 'githubIssueNumber', 'state', 'decidedBy', 'decidedAt',
                'createdAt', 'v'])
          && request.resource.data.requesterUid == me()
          && request.resource.data.state == 'pending'
          && str(request.resource.data.note, 1, 280)
          && (!('repoOwnerUid' in request.resource.data)
              || request.resource.data.repoOwnerUid == repoData(gid, request.resource.data.repoId).ownerUid);
        allow update: if isMember(gid) && (
          // decide: repo owner or admin
          (resource.data.state == 'pending'
            && request.resource.data.state in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['state', 'decidedBy', 'decidedAt'])
            && request.resource.data.decidedBy == me()
            && (isAdmin(gid) || repoData(gid, resource.data.repoId).ownerUid == me()))
          ||
          // requester: attach issue number after creating it on GitHub
          (resource.data.requesterUid == me()
            && resource.data.state == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['githubIssueNumber']))
          ||
          // requester: cancel while pending
          (resource.data.requesterUid == me()
            && resource.data.state == 'pending'
            && request.resource.data.state == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']))
        );
        allow delete: if isAdmin(gid); // group-deletion sweep only; app offers no per-request delete
      }

      // ---------- announcements — the circle's voice (M17) ----------
      // Admin-only, append-only. An announcement is a statement made at a
      // moment; correcting it means posting again, not rewriting history.
      match /announcements/{annId} {
        allow read: if isMember(gid);
        allow create: if isAdmin(gid)
          && request.resource.data.keys().hasOnly(
               ['body', 'authorUid', 'authorLogin', 'authorAvatarUrl', 'createdAt', 'v'])
          && request.resource.data.authorUid == me()
          && str(request.resource.data.body, 1, 280);
        allow update: if false;
        allow delete: if isAdmin(gid);
      }

      // ---------- meta/summary — Home's one read (M16, ADR-021) ----------
      // Maintained by member clients at write time; Spark has no triggers.
      // Guests may write it as well: a member count left wrong by one after a
      // guest joins is a visible lie, and that costs more than the blast radius
      // of a shape-capped display document.
      match /meta/{docId} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && docId == 'summary'
          && validSummary(request.resource.data)
          && (isAdmin(gid) || !summaryTouchesAdminKeys());
        allow delete: if isAdmin(gid);
      }

      // ---------- integrations ----------
      match /integrations/{kind} {
        allow read: if isMember(gid);   // members' clients post to the webhook (SECURITY §7)
        allow create, update: if isAdmin(gid) && kind in ['discord', 'slack']
          && request.resource.data.keys().hasOnly(
               ['webhookUrl', 'channelLabel', 'postAsks', 'postClaims', 'postCollabs',
                'postShipped', 'configuredBy', 'updatedAt', 'v'])
          && (kind != 'discord'
              || request.resource.data.webhookUrl
                   .matches('^https://discord\\.com/api/webhooks/[0-9]{1,30}/[A-Za-z0-9_.-]{1,120}$'))
          && optStr(request.resource.data, 'channelLabel', 60);
        allow delete: if isAdmin(gid);
      }

      // ---------- audit log ----------
      match /auditLog/{entryId} {
        allow read: if isAdmin(gid);
        allow create: if isMember(gid)
          && request.resource.data.keys().hasOnly(
               ['actorUid', 'actorLogin', 'action', 'subjectType', 'subjectId', 'detail',
                'createdAt', 'v'])
          && request.resource.data.actorUid == me()
          && str(request.resource.data.action, 1, 40)
          && optStr(request.resource.data, 'detail', 200);
        allow update: if false;
        allow delete: if isAdmin(gid); // group-deletion sweep; audit stays append-only otherwise
      }
    }

    // ---------- default deny backstop ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
