{
  "name": "repocircle",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx -y firebase-tools@14 emulators:start --only firestore,auth",
    "deploy:rules": "npx -y firebase-tools@14 deploy --only firestore --project repocircle-3e9a6"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "firebase": "^12.18.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
